# ---- Nguồn dữ liệu: mock (giả lập STM32) | uart (STM32 thật qua PySerial) ----
DATA_SOURCE=mock
UART_PORT=/dev/ttyUSB0
UART_BAUDRATE=115200
UART_TIMEOUT=3.0

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# ---- Đăng nhập dashboard (đổi mật khẩu trước khi triển khai) ----
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# ---- Vehicle ----
VEHICLE_NAME=DHMR-32000
TELEMETRY_RATE_HZ=5
HOME_LAT=16.0748
HOME_LON=108.1500
ACCEPTANCE_RADIUS=3.0

# ---- Safety ----
BATTERY_WARN=30
BATTERY_CRITICAL=15
GEOFENCE_RADIUS=1500
AUTO_RTL_ON_ABORT=false

# ---- Mock simulation ----
MOCK_CRUISE_SPEED=6.0
MOCK_TURN_RATE=70
MOCK_BATTERY_DRAIN=1.5
MOCK_INITIAL_BATTERY=92

# ---- Map (đổi sang tile server nội bộ nếu chạy offline) ----
MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
