# 1. Chuyển từ mock sang uart
DATA_SOURCE=uart

# 2. Cổng UART trên Jetson (xem mục 2 bên dưới để chọn đúng cổng)
UART_PORT=/dev/ttyTHS1
UART_BAUDRATE=115200
UART_TIMEOUT=3.0

# 3. Để truy cập từ xa qua mạng LAN/Wifi
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 4. Tọa độ xe/lab thực tế của bạn
HOME_LAT=16.0748
HOME_LON=108.1500

AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

MAP_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; OpenStreetMap contributors